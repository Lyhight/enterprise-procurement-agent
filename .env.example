APP_ENV=development
# 普通 wheel/容器安装时可显式指定包含 data、evals 和 frontend 的项目目录
# PROJECT_ROOT=E:\dataset\agent\Purchase
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
DATABASE_PATH=
CORS_ORIGINS=http://127.0.0.1:5173
LLM_PROVIDER=local
OPENAI_MODEL=gpt-6-astra
# OPENAI_API_KEY=
AGENT_MAX_ITERATIONS=10
AGENT_MAX_RUNTIME_SECONDS=30
AUTH_ENABLED=false
# AUTH_TOKENS=replace-with-long-random-token|E001|PROCUREMENT
INTEGRATION_MODE=mock
# OA_BASE_URL=https://oa.example.internal
# OA_API_TOKEN=
# ERP_BASE_URL=https://erp.example.internal
# ERP_API_TOKEN=
INTEGRATION_TIMEOUT_SECONDS=10
SUPPLIER_DELIVERY_MODE=mock
# SUPPLIER_GATEWAY_URL=https://supplier-gateway.example.internal
# SUPPLIER_GATEWAY_TOKEN=
# SUPPLIER_CALLBACK_SECRET=replace-with-a-long-random-secret
SUPPLIER_CALLBACK_TOLERANCE_SECONDS=300

